# Copy outside the directory served by your web server, then use --env-file.
# Production and test must use separate database credentials and databases.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://visual_notes:replace-me@127.0.0.1:5432/visual_notes_dev
APP_ORIGIN=https://notes-test.example.com
GOOGLE_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-web-client-secret
